#!/usr/bin/env python3
"""Stands in for kubectl in tests and the demo: serves made-up objects from tests/fixtures."""
import json, os, sys
from pathlib import Path

args = sys.argv[1:]
if os.environ.get("FAKE_LOG"):
    with open(os.environ["FAKE_LOG"], "a") as log:
        log.write("kubectl " + " ".join(args) + "\n")
if args[:2] == ["--context", args[1] if len(args) > 1 else ""]:
    args = args[2:]
if args[:2] == ["config", "current-context"]:
    print("demo-cluster")
    sys.exit(0)
resource = args[1]
if resource in os.environ.get("FAKE_DENY", "").split(","):
    sys.stderr.write(f'Error from server (Forbidden): {resource} is forbidden\n')
    sys.exit(1)
path = Path(__file__).resolve().parent.parent / "fixtures" / "kube" / f"{resource}.json"
print(path.read_text() if path.exists() else json.dumps({"items": []}))
